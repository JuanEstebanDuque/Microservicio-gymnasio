    {
      "name": "Entrenador (:8083)",
      "item": [
        {
          "name": "Listar entrenadores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador"
              ]
            }
          }
        },
        {
          "name": "Crear entrenador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('entrenador_id', body.id);",
                  "  console.log('entrenador_id guardado:', body.id);",
                  "}",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Rodríguez\",\n  \"especialidad\": \"Yoga\"\n}"
            },
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador"
              ]
            }
          },
          "description": "Guarda automáticamente el id creado en la variable de entorno entrenador_id, para usarlo luego al programar una clase."
        },
        {
          "name": "Obtener entrenador por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador/{{entrenador_id}}",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador",
                "{{entrenador_id}}"
              ]
            }
          }
        },
        {
          "name": "Actualizar entrenador",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Rodríguez\",\n  \"especialidad\": \"CrossFit\"\n}"
            },
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador/{{entrenador_id}}",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador",
                "{{entrenador_id}}"
              ]
            }
          }
        },
