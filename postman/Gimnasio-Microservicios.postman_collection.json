  "item": [
    {
      "name": "Autenticación (Keycloak) - ejecutar primero",
      "item": [
        {
          "name": "Token admin (ROLE_ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token obtenido', () => pm.response.to.have.status(200));",
                  "pm.environment.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "entrenadores-client"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "admin123"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/gimnasio/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "gimnasio",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          }
        },
