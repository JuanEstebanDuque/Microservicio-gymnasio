{
  "info": {
    "name": "Gimnasio - Microservicios",
    "description": "Colección para probar los microservicios de Miembro, Equipo, Entrenador y Clase del Sistema de Gestión de un Gimnasio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
