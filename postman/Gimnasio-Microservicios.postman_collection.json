    {
      "name": "Clase (:8082)",
      "item": [
        {
          "name": "Listar clases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{clase_url}}/api/clase",
              "host": [
                "{{clase_url}}"
              ],
              "path": [
                "api",
                "clase"
              ]
            }
          }
        },
        {
          "name": "Programar clase (entrenador válido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('clase_id', body.id);",
                  "  console.log('clase_id guardado:', body.id);",
                  "}",
                  "pm.test('No dio error', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Yoga Matutino\",\n  \"horario\": \"2026-09-01T08:00:00\",\n  \"capacidadMaxima\": 20,\n  \"entrenadorId\": {{entrenador_id}}\n}"
            },
            "url": {
              "raw": "{{clase_url}}/api/clase",
              "host": [
                "{{clase_url}}"
              ],
              "path": [
                "api",
                "clase"
              ]
            }
          },
          "description": "Usa el entrenador_id capturado por la petición 'Crear entrenador'. Ejecútala primero."
        },
        {
          "name": "Obtener clase por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{clase_url}}/api/clase/{{clase_id}}",
              "host": [
                "{{clase_url}}"
              ],
              "path": [
                "api",
                "clase",
                "{{clase_id}}"
              ]
            }
          }
        },
        {
          "name": "Programar clase (entrenador inexistente -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Spinning Vespertino\",\n  \"horario\": \"2026-09-01T18:00:00\",\n  \"capacidadMaxima\": 15,\n  \"entrenadorId\": 9999\n}"
            },
            "url": {
              "raw": "{{clase_url}}/api/clase",
              "host": [
                "{{clase_url}}"
              ],
              "path": [
                "api",
                "clase"
              ]
            }
          },
          "description": "entrenadorId=9999 no existe: debe responder 400. Si además detienes el microservicio de Entrenador, esta misma petición debe responder 503 en vez de 400."
        }
      ]
