    {
      "name": "Seguridad (401 / 403)",
      "item": [
        {
          "name": "Sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador"
              ]
            }
          }
        },
        {
          "name": "Token inválido -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "abc.def.ghi",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador"
              ]
            }
          }
        },
        {
          "name": "Rol insuficiente: crear entrenador con token member/trainer -> 403 (usar antes 'Token member')",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "auth": null,
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{entrenador_url}}/api/entrenador",
              "host": [
                "{{entrenador_url}}"
              ],
              "path": [
                "api",
                "entrenador"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"X\",\"especialidad\":\"Y\"}"
            }
          }
        }
      ]
